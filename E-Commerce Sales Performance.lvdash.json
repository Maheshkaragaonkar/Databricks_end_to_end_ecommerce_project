{
  "datasets": [
    {
      "name": "ecc20b3a",
      "displayName": "fact_transactions_denorm",
      "config": {
        "version": "1.1",
        "source": "ecommerce.gold.fact_transactions_denorm",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "displayName": "Total Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "abbreviation": "compact"
            },
            "name": "total_revenue",
            "expr": "SUM(`net_amount`)",
            "comment": "Sum of net amount across all transactions"
          },
          {
            "name": "total_orders",
            "expr": "COUNT(DISTINCT `transaction_id`)",
            "displayName": "Total Orders",
            "comment": "Distinct count of transactions"
          },
          {
            "name": "total_units",
            "expr": "SUM(`quantity`)",
            "displayName": "Units Sold",
            "comment": "Total quantity of items sold"
          },
          {
            "displayName": "Avg Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_order_value",
            "expr": "SUM(`net_amount`) / COUNT(DISTINCT `transaction_id`)",
            "comment": "Net revenue divided by distinct transactions"
          }
        ]
      }
    }
  ],
